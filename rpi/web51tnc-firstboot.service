[Unit]
Description=Web51TNC appliance first-boot provisioning (LAN DHCP, NAT, app deploy)
Documentation=https://github.com/oh2fxd/web51tnc
# Deliberately not ordering on network-online.target: the script does its own
# bounded wait for wlan0, so a slow Wi-Fi association cannot stall the boot.
After=NetworkManager.service
Wants=NetworkManager.service
ConditionPathExists=!/var/lib/web51tnc/.firstboot-done

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/web51tnc-firstboot.sh
RemainAfterExit=yes
TimeoutStartSec=900
Nice=10

[Install]
WantedBy=multi-user.target
